{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/install-statusline.py\" --auto",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q 'bin/claude-usage-line' \"$HOME/.claude/settings.json\" || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/install-statusline.py\" --auto",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
